# Copy to .env (gitignored) for local runs, or set these as real environment variables /
# MCP client config env vars. See SECURITY.md. Never commit real tokens.

RAG_MCP_BACKEND_BASE_URL=http://localhost:8080

# stdio mode: YOUR OWN backend token (bare; no "Bearer " prefix, no quotes).
RAG_USER_TOKEN=

# Optional, defaults shown:
# RAG_MCP_TRANSPORT=stdio                # or streamable-http (token then comes from each request's Authorization header)
# RAG_MCP_HTTP_HOST=127.0.0.1
# RAG_MCP_HTTP_PORT=8000
# RAG_MCP_REQUEST_TIMEOUT_SECONDS=30

# DEGRADED MODE (off by default, not recommended): serve token-less requests as ONE shared account.
# Credentials set without the flag make startup fail. See SECURITY.md.
# RAG_MCP_ALLOW_SHARED_SERVICE_ACCOUNT=false
# RAG_MCP_SERVICE_USERNAME=
# RAG_MCP_SERVICE_PASSWORD=
# RAG_MCP_TOKEN_REFRESH_MARGIN_SECONDS=60
